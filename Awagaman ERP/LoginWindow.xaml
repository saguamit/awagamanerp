<Window x:Class="Awagaman_ERP.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Awagaman ERP Login"
        Height="470"
        Width="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F7FB">
    <Border Margin="22" Background="White" CornerRadius="16" BorderBrush="#D8E0EB" BorderThickness="1">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Sign In" FontSize="26" FontWeight="Bold" Foreground="#0F172A"/>
            <TextBlock Grid.Row="1" Margin="0,8,0,24" Text="Remote mode requires a valid user account." Foreground="#475569"/>

            <StackPanel Grid.Row="2">
                <TextBlock Text="Username" FontWeight="SemiBold" Foreground="#1E293B"/>
                <TextBox x:Name="UsernameBox"
                         Height="38"
                         Margin="0,6,0,14"
                         Padding="10,6"
                         BorderBrush="#CBD5E1"
                         BorderThickness="1"
                         Background="White"
                         Foreground="#0F172A"/>

                <TextBlock Text="Password" FontWeight="SemiBold" Foreground="#1E293B"/>
                <PasswordBox x:Name="PasswordBox"
                             Height="38"
                             Margin="0,6,0,0"
                             Padding="10,6"
                             BorderBrush="#CBD5E1"
                             BorderThickness="1"
                             Background="White"
                             Foreground="#0F172A"/>

                <TextBlock x:Name="ErrorText"
                           Margin="0,14,0,0"
                           Foreground="#B91C1C"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"/>
            </StackPanel>

            <Grid Grid.Row="3" Margin="0,24,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0"
                           Foreground="#64748B"
                           Text="Default admin: admin / Admin@123"
                           TextWrapping="Wrap"
                           Margin="0,0,0,12"/>
                <Button x:Name="LoginButton"
                        Grid.Row="1"
                        Content="Login"
                        Width="110"
                        Height="38"
                        HorizontalAlignment="Right"
                        Click="Login_Click"
                        IsDefault="True"
                        Background="#1565C0"
                        Foreground="White"
                        BorderThickness="0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
