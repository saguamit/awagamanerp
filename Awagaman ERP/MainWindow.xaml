<Controls:MetroWindow x:Class="Awagaman_ERP.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:local="clr-namespace:Awagaman_ERP"

        xmlns:Controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"

        xmlns:dgx="urn:tom-englert.de/DataGridExtensions"

        mc:Ignorable="d"

        x:Name="Root"

        Title="Awagaman ERP - Challan Ledger" 

        Height="650" Width="1300"
        Background="#EEEEEE"
        Icon="pack://siteoforigin:,,,/logo.ico"

        WindowState="Maximized"

        WindowStartupLocation="CenterScreen"

        PreviewKeyDown="MainWindow_PreviewKeyDown">

    <Controls:MetroWindow.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <ControlTemplate x:Key="MultiFilterTemplate">

            <dgx:MultipleChoiceFilter Filter="{Binding Path=Filter, RelativeSource={RelativeSource FindAncestor, AncestorType=dgx:DataGridFilterColumnControl}}"/>

        </ControlTemplate>



        <!-- Colors based on reference image -->

        <SolidColorBrush x:Key="ThemeBlue" Color="#18609A" />

        <SolidColorBrush x:Key="ThemeGreen" Color="#00B08B" />

        <SolidColorBrush x:Key="SidebarBg" Color="#1E659D" />

        <SolidColorBrush x:Key="AppBg" Color="#EEEEEE" />

        <SolidColorBrush x:Key="TextDark" Color="#333333" />

        <SolidColorBrush x:Key="TextMuted" Color="#777777" />

        <SolidColorBrush x:Key="BorderLight" Color="#DDDDDD" />



        <!-- Sidebar Button Style -->

        <Style x:Key="SidebarButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Height" Value="60" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="bg" Background="{TemplateBinding Background}">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*" />

                                    <ColumnDefinition Width="Auto" />

                                </Grid.ColumnDefinitions>

                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                                    <Path Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Width="20" Height="20" Stretch="Uniform" Stroke="{TemplateBinding Foreground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Fill="Transparent" HorizontalAlignment="Center" Margin="0,0,0,4" />

                                    <TextBlock Text="{TemplateBinding Content}" FontSize="12" HorizontalAlignment="Center" />

                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="+" Foreground="#88B1D4" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />

                            </Grid>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="bg" Property="Background" Value="#135284" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- Tab Style -->

        <Style x:Key="TabButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="Transparent" />

            <Setter Property="Foreground" Value="#888888" />

            <Setter Property="BorderThickness" Value="0,0,0,3" />

            <Setter Property="BorderBrush" Value="Transparent" />

            <Setter Property="FontSize" Value="12.5" />

            <Setter Property="FontWeight" Value="Bold" />

            <Setter Property="Padding" Value="12,10" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Foreground" Value="{StaticResource ThemeBlue}" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <Style x:Key="ActiveTabButtonStyle" TargetType="Button" BasedOn="{StaticResource TabButtonStyle}">

            <Setter Property="Foreground" Value="{StaticResource ThemeBlue}" />

            <Setter Property="BorderBrush" Value="{StaticResource ThemeBlue}" />

        </Style>



        <!-- Green Action Button Style -->

        <Style x:Key="GreenButtonStyle" TargetType="Button">

            <Setter Property="Background" Value="{StaticResource ThemeGreen}" />

            <Setter Property="Foreground" Value="White" />

            <Setter Property="BorderThickness" Value="0" />

            <Setter Property="Padding" Value="12,6" />

            <Setter Property="FontSize" Value="12" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border Background="{TemplateBinding Background}" CornerRadius="2">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter Property="Background" Value="#009A7A" />

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- ComboBox placeholder style -->

        <Style x:Key="FilterComboBox" TargetType="ComboBox">

            <Setter Property="Width" Value="110" />

            <Setter Property="Height" Value="26" />

            <Setter Property="Margin" Value="4,0" />

            <Setter Property="FontSize" Value="12" />

        </Style>



        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">

            <Setter Property="Background" Value="#F8F8F8"/>

            <Setter Property="Foreground" Value="#333333"/>

            <Setter Property="FontWeight" Value="Bold"/>

            <Setter Property="Padding" Value="10,12"/>

            <Setter Property="BorderBrush" Value="#DDDDDD"/>

            <Setter Property="BorderThickness" Value="0,1,0,1"/>

        </Style>





    </Controls:MetroWindow.Resources>



    <Grid Background="#EEEEEE">

        <Grid.ColumnDefinitions>

            <!-- Sidebar -->

            <ColumnDefinition Width="100" x:Name="SidebarColumn" />

            <!-- Main Content -->

            <ColumnDefinition Width="*" />

        </Grid.ColumnDefinitions>



        <!-- Left Sidebar -->

        <Border Grid.Column="0" Background="{StaticResource SidebarBg}">

            <Grid>

                <Grid.RowDefinitions>

                    <RowDefinition Height="Auto" />

                    <RowDefinition Height="*" />

                </Grid.RowDefinitions>

                

                <!-- Profile Area -->

                <Border Grid.Row="0" Background="White" Padding="0,16" Margin="0,0,0,1">

                    <StackPanel>

                        <Image Source="logo.png" Width="52" Height="52" Stretch="Uniform" HorizontalAlignment="Center" />
                        <TextBlock Text="Awagaman Trans Logistics" Foreground="{StaticResource ThemeBlue}" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="6,8,6,0" />

                    </StackPanel>

                </Border>



                <!-- Navigation Links -->

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">

                    <StackPanel>

                        <Button Content="Sales" Tag="M3,20 L21,20 M6,17 L6,11 M12,17 L12,5 M18,17 L18,8" Style="{StaticResource SidebarButtonStyle}" />

                        <Button x:Name="SidebarLedgersButton" Content="Ledgers" Tag="M3,7 L14,7 L14,17 L3,17 Z M14,10 L18,10 L21,14 L21,17 L14,17 M6,19 A2,2 0 1,0 6,15 A2,2 0 1,0 6,19 M18,19 A2,2 0 1,0 18,15 A2,2 0 1,0 18,19" Style="{StaticResource SidebarButtonStyle}" Foreground="{StaticResource ThemeBlue}" Background="#F3F4F6" Click="OpenDashboard_Click" ToolTip="Open ledger workspace" />

                        <Button Content="Purchase" Tag="M3,4 L5,4 L7,14 L18,14 L20,7 L6,7 M8,20 A2,2 0 1,0 8,16 A2,2 0 1,0 8,20 M17,20 A2,2 0 1,0 17,16 A2,2 0 1,0 17,20" Style="{StaticResource SidebarButtonStyle}" />

                        <Button x:Name="SidebarReturnsButton" Content="Deleted" Tag="M6,7 L18,7 M9,7 L9,5 L15,5 L15,7 M8,9 L9,19 L15,19 L16,9 Z M11,11 L11,17 M13,11 L13,17" Style="{StaticResource SidebarButtonStyle}" Click="OpenReturns_Click" />

                        <Button x:Name="SidebarUsersButton" Content="Users" Tag="M12,4 A4,4 0 1,0 12,12 A4,4 0 1,0 12,4 M5,20 C5,16 8,14 12,14 C16,14 19,16 19,20" Style="{StaticResource SidebarButtonStyle}" Click="OpenUsers_Click" />

                        <Button x:Name="SidebarImportButton" Content="Imports" Tag="M12,3 L12,15 M8,11 L12,15 L16,11 M5,20 L19,20" Style="{StaticResource SidebarButtonStyle}" Click="OpenImportGuide_Click" />
                        <Button x:Name="SidebarExportButton" Content="Exports" Tag="M5,4 L19,4 L19,20 L5,20 Z M8,8 L16,8 M8,12 L16,12 M8,16 L13,16" Style="{StaticResource SidebarButtonStyle}" Click="OpenExportHub_Click" />
                        <Button x:Name="SidebarReportsButton" Content="Reports" Tag="M4,20 L20,20 M7,17 L7,12 M12,17 L12,7 M17,17 L17,10" Style="{StaticResource SidebarButtonStyle}" Click="OpenReports_Click" />
                        <Button x:Name="SidebarFundsButton" Content="Funds" Tag="M4,8 L20,8 L20,18 L4,18 Z M7,13 L17,13 M8,5 L16,5 M8,21 L16,21" Style="{StaticResource SidebarButtonStyle}" Click="OpenFundsOverview_Click" ToolTip="Invested and received money overview" />

                    </StackPanel>

                </ScrollViewer>

            </Grid>

        </Border>



        <!-- Main Workspace -->

        <Grid Grid.Column="1" Margin="24">

            <Grid.RowDefinitions>

                <RowDefinition Height="Auto" /> <!-- Title -->

                <RowDefinition Height="*" />    <!-- White Card -->

            </Grid.RowDefinitions>



            <!-- Page Title Area -->

            <Grid Grid.Row="0" Margin="0,0,0,16">

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                    <Button Content="Menu" FontSize="13" Background="Transparent" BorderBrush="#D1D5DB" BorderThickness="1" Padding="10,4" Foreground="#555555" Margin="0,0,16,0" Cursor="Hand" Click="ToggleSidebar_Click" ToolTip="Hide / Show left menu" />

                    <TextBlock x:Name="PageTitle" Text="Purchase List" FontSize="18" Foreground="#555555" FontWeight="SemiBold" VerticalAlignment="Center" />

                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <TextBlock Text="Home / Dashboard" Foreground="#888888" FontSize="12" />

                </StackPanel>

            </Grid>



            <!-- White Main Card -->

            <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderLight}" BorderThickness="1">

                <Grid>

                    <Grid.RowDefinitions>

                        <RowDefinition Height="Auto" /> <!-- Tabs -->

                        <RowDefinition Height="Auto" /> <!-- Summary & Add Button -->

                        <RowDefinition Height="Auto" /> <!-- Search & Filter -->

                        <RowDefinition Height="Auto" /> <!-- Show Entries -->

                        <RowDefinition Height="*" />    <!-- DataGrid -->

                    </Grid.RowDefinitions>



                    <!-- Row 0: Tabs -->

                    <Border Grid.Row="0" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                <Button x:Name="TabDashboard" Content="Dashboard" Style="{StaticResource ActiveTabButtonStyle}" Width="126" Click="OpenDashboard_Click" />
                                <Button x:Name="TabBillLedger" Content="Bill Ledger" Style="{StaticResource TabButtonStyle}" Width="126" Click="OpenBillLedger_Click" />
                                <Button x:Name="TabCBSLedger" Content="CBS" Style="{StaticResource TabButtonStyle}" Width="92" Click="OpenCBSLedger_Click" />
                                <Button x:Name="TabPartyLedger" Content="Party Ledger" Style="{StaticResource TabButtonStyle}" Width="128" Click="OpenPartyLedgerTab_Click" />
                                <Button x:Name="TabVehicleLedger" Content="Vehicle Ledger" Style="{StaticResource TabButtonStyle}" Width="136" Click="OpenVehicleLedgerTab_Click" />
                                <Button x:Name="TabLRLedger" Content="LR Ledger" Style="{StaticResource TabButtonStyle}" Width="114" Click="OpenLRLedger_Click" />
                                <Button x:Name="TabDeliveryChallans" Content="Purchase" Style="{StaticResource TabButtonStyle}" Width="114" Click="OpenDeliveryChallans_Click" />
                                <Button x:Name="TabChallan" Content="Chllan" Style="{StaticResource TabButtonStyle}" Width="106" Click="OpenChallanTab_Click" />
                                <Button x:Name="TabTrackingLedger" Content="Tracking Ledger" Style="{StaticResource TabButtonStyle}" Width="134" Click="OpenTrackingLedger_Click" />
                            </StackPanel>

                            <Button x:Name="TopResetDataButton" Grid.Column="1" Content="Reset Data" Background="#C62828" Foreground="White" BorderThickness="0" Padding="12,6" FontSize="12" Cursor="Hand" Click="ResetAllData_Click" ToolTip="Delete all ledger data" Margin="8,8,12,8" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                    </Border>



                    <!-- Import Guide View -->
                    <Grid x:Name="ImportGuideView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="White">
                        <ContentControl x:Name="ImportGuideContentHost" />
                    </Grid>

                    <!-- Export View -->
                    <Grid x:Name="ExportView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="White">
                        <ContentControl x:Name="ExportContentHost" />
                    </Grid>

                    <!-- Reports View -->
                    <Grid x:Name="ReportsView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="White">
                        <ContentControl x:Name="ReportsContentHost" />
                    </Grid>

                    <!-- Funds View -->
                    <Grid x:Name="FundsView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="White">
                        <ContentControl x:Name="FundsContentHost" />
                    </Grid>

                    <!-- Users View -->
                    <Grid x:Name="UsersView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="White">
                        <ContentControl x:Name="UsersContentHost" />
                    </Grid>

                    <!-- Returns View -->
                    <Grid x:Name="ReturnsView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="White">
                        <ContentControl x:Name="ReturnsContentHost" />
                    </Grid>

                    <!-- Dashboard View -->
                    <Grid x:Name="DashboardView" Grid.Row="1" Grid.RowSpan="4">
                        <Grid.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#F7FAFF" Offset="0" />
                                <GradientStop Color="#EEF4FF" Offset="0.52" />
                                <GradientStop Color="#EAF7F4" Offset="1" />
                            </LinearGradientBrush>
                        </Grid.Background>

                        <Grid.Resources>
                            <Style x:Key="DashboardCardStyle" TargetType="Border">
                                <Setter Property="CornerRadius" Value="18" />
                                <Setter Property="Background" Value="White" />
                                <Setter Property="BorderBrush" Value="#DDE6F4" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="Padding" Value="18" />
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect BlurRadius="18" ShadowDepth="2" Color="#1A335A" Opacity="0.10" />
                                    </Setter.Value>
                                </Setter>
                            </Style>
                            <Style x:Key="DashboardMetricLabel" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#5A6B82" />
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                            <Style x:Key="DashboardMetricValue" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#13233B" />
                                <Setter Property="FontSize" Value="30" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                            <Style x:Key="DashboardMetricHint" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#71839A" />
                                <Setter Property="FontSize" Value="11" />
                            </Style>
                            <Style x:Key="DashboardSectionTitle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#153B63" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Style>
                            <Style x:Key="DashboardSectionSubTitle" TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#64748B" />
                                <Setter Property="FontSize" Value="10.5" />
                            </Style>
                            <Style x:Key="DashboardActionButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="#7C3AED" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="12,0" />
                                <Setter Property="Height" Value="28" />
                                <Setter Property="MinWidth" Value="84" />
                                <Setter Property="FontSize" Value="10" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}">
                                                <Border.Effect>
                                                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Color="#1A335A" Opacity="0.12" />
                                                </Border.Effect>
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Grid.Resources>

                        <Grid Margin="24">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="20" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border x:Name="DashboardDueCard" Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Background="#FFF7ED"
                                        Cursor="Hand" ToolTip="Open challan ledger with only due rows" MouseLeftButtonUp="DashboardDueCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#F97316" CornerRadius="12" HorizontalAlignment="Left" Padding="10,5">
                                            <TextBlock Text="Cash flow" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="#FFF0DF" CornerRadius="16" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Path Data="M4,18 L9,18 L9,10 L15,10 L15,18 L20,18 L12,26 Z M5,5 L19,5 L19,8 L5,8 Z" Fill="#F97316" Stretch="Uniform" Width="18" Height="18" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                            <TextBlock Text="Total Due" Style="{StaticResource DashboardMetricLabel}" Foreground="#C2410C" />
                                            <TextBlock x:Name="DashboardTotalDue" Text="Rs. 0.00" Style="{StaticResource DashboardMetricValue}" Foreground="#9A3412" Margin="0,4,0,0" />
                                            <TextBlock x:Name="DashboardTotalChallans" Text="0 Challans" Style="{StaticResource DashboardMetricHint}" Foreground="#C2410C" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="DashboardBillsCard" Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Background="#ECFDF3"
                                        Cursor="Hand" ToolTip="Open pending bills window" MouseLeftButtonUp="DashboardBillsCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#16A34A" CornerRadius="12" HorizontalAlignment="Left" Padding="10,5">
                                            <TextBlock Text="Bills" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="#DCFCE7" CornerRadius="16" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Path Data="M6,3 L18,3 L22,7 L22,25 L6,25 Z M18,3 L18,8 L22,8 M9,12 L19,12 M9,16 L19,16 M9,20 L16,20" Stroke="#16A34A" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform" Width="18" Height="18" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                            <TextBlock Text="Outstanding" Style="{StaticResource DashboardMetricLabel}" Foreground="#166534" />
                                            <TextBlock x:Name="DashboardOutstanding" Text="Rs. 0.00" Style="{StaticResource DashboardMetricValue}" Foreground="#14532D" Margin="0,4,0,0" />
                                            <TextBlock x:Name="DashboardPendingBills" Text="0 Pending Bills" FontSize="16" FontWeight="SemiBold" Foreground="#166534" Margin="0,8,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="DashboardCbsCard" Grid.Column="4" Style="{StaticResource DashboardCardStyle}" Background="#EFF6FF"
                                        Cursor="Hand" ToolTip="Open CBS ledger" MouseLeftButtonUp="DashboardCBSCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#2563EB" CornerRadius="12" HorizontalAlignment="Left" Padding="10,5">
                                            <TextBlock Text="CBS" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="#DBEAFE" CornerRadius="16" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Path Data="M4,9 L14,4 L24,9 Z M6,11 L6,21 M12,11 L12,21 M18,11 L18,21 M22,11 L22,21 M4,23 L24,23" Stroke="#2563EB" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform" Width="20" Height="20" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                            <TextBlock Text="Bank Net" Style="{StaticResource DashboardMetricLabel}" Foreground="#1D4ED8" />
                                            <TextBlock x:Name="DashboardCBSBankNet" Text="Rs. 0.00" Style="{StaticResource DashboardMetricValue}" Foreground="#1E3A8A" Margin="0,4,0,0" />
                                            <TextBlock Text="Cash Net" Style="{StaticResource DashboardMetricLabel}" Foreground="#0369A1" Margin="0,10,0,0" />
                                            <TextBlock x:Name="DashboardCBSCashNet" Text="Rs. 0.00" Style="{StaticResource DashboardMetricValue}" Foreground="#0F766E" Margin="0,4,0,0" />
                                            <TextBlock Text="Open CBS ledger" Style="{StaticResource DashboardMetricHint}" Foreground="#1D4ED8" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border x:Name="DashboardBookingsCard" Grid.Column="6" Style="{StaticResource DashboardCardStyle}" Background="#F5F3FF"
                                        Cursor="Hand" ToolTip="Open LR creation form" MouseLeftButtonUp="DashboardBookingsCard_Click">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#7C3AED" CornerRadius="12" HorizontalAlignment="Left" Padding="10,5">
                                            <TextBlock Text="Bookings" Foreground="White" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                        <Border Background="#EDE9FE" CornerRadius="16" Width="34" Height="34" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Path Data="M5,7 L21,7 L21,22 L5,22 Z M8,4 L8,10 M18,4 L18,10 M8,13 L18,13 M8,17 L15,17" Stroke="#7C3AED" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent" Stretch="Uniform" Width="19" Height="19" />
                                        </Border>
                                        <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                            <TextBlock Text="New Bookings" Style="{StaticResource DashboardMetricLabel}" Foreground="#6D28D9" />
                                            <TextBlock x:Name="DashboardNewBookings" Text="0" Style="{StaticResource DashboardMetricValue}" Foreground="#5B21B6" Margin="0,4,0,0" />
                                            <TextBlock Text="Challans without an LR number yet" Style="{StaticResource DashboardMetricHint}" Foreground="#6D28D9" Margin="0,6,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource DashboardCardStyle}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#FFF7ED" BorderBrush="#FED7AA" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0" Padding="18,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Pending Dispatch" Style="{StaticResource DashboardSectionTitle}" Foreground="#9A3412" />
                                                    <TextBlock Text="Tracking rows not dispatched yet" Style="{StaticResource DashboardSectionSubTitle}" Foreground="#C2410C" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="From" VerticalAlignment="Center" Foreground="#9A3412" FontSize="11" FontWeight="SemiBold" />
                                                <TextBox x:Name="DashboardPendingDispatchFromSearchBox"
                                                         Grid.Column="4"
                                                         Height="26"
                                                         Padding="6,2"
                                                         VerticalAlignment="Center"
                                                         TextChanged="DashboardPendingDispatchFilter_TextChanged" />
                                                <TextBlock Grid.Column="6" Text="To" VerticalAlignment="Center" Foreground="#9A3412" FontSize="11" FontWeight="SemiBold" />
                                                <TextBox x:Name="DashboardPendingDispatchToSearchBox"
                                                         Grid.Column="7"
                                                         Height="26"
                                                         Padding="6,2"
                                                         VerticalAlignment="Center"
                                                         TextChanged="DashboardPendingDispatchFilter_TextChanged" />
                                                <Border Grid.Column="9" Background="#F97316" CornerRadius="14" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DashboardPendingDispatchCount" Text="0" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataGrid Grid.Row="1"
                                                  x:Name="DashboardPendingDispatchGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderThickness="0"
                                                  Background="White"
                                                  RowBackground="White"
                                                  AlternatingRowBackground="#FFFDF8"
                                                  AlternationCount="2"
                                                  SelectionMode="Single"
                                                  Margin="14,10,14,14"
                                                  MouseDoubleClick="DashboardTrackingGrid_MouseDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Challan" Binding="{Binding ChallanNo}" Width="110" />
                                                <DataGridTextColumn Header="Date" Binding="{Binding ChallanDate, StringFormat=dd-MMM-yy}" Width="92" />
                                                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="*" />
                                                <DataGridTextColumn Header="To" Binding="{Binding To}" Width="*" />
                                                <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNo}" Width="120" />
                                                <DataGridTemplateColumn Header="Eway Till" Width="96">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding EwayBillTillDate, StringFormat=dd-MMM-yy}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#111827" />
                                                                        <Setter Property="FontWeight" Value="Normal" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsEwayDueSoon}" Value="True">
                                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource DashboardCardStyle}" Padding="0">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0" Padding="18,14">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="160" />
                                                    <ColumnDefinition Width="12" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="In Transit" Style="{StaticResource DashboardSectionTitle}" Foreground="#1D4ED8" />
                                                    <TextBlock Text="Dispatched loads with live updates" Style="{StaticResource DashboardSectionSubTitle}" Foreground="#2563EB" Margin="0,3,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Text="From" VerticalAlignment="Center" Foreground="#1D4ED8" FontSize="11" FontWeight="SemiBold" />
                                                <TextBox x:Name="DashboardInTransitFromSearchBox"
                                                         Grid.Column="4"
                                                         Height="26"
                                                         Padding="6,2"
                                                         VerticalAlignment="Center"
                                                         TextChanged="DashboardInTransitFilter_TextChanged" />
                                                <TextBlock Grid.Column="6" Text="To" VerticalAlignment="Center" Foreground="#1D4ED8" FontSize="11" FontWeight="SemiBold" />
                                                <TextBox x:Name="DashboardInTransitToSearchBox"
                                                         Grid.Column="7"
                                                         Height="26"
                                                         Padding="6,2"
                                                         VerticalAlignment="Center"
                                                         TextChanged="DashboardInTransitFilter_TextChanged" />
                                                <Border Grid.Column="9" Background="#2563EB" CornerRadius="14" Padding="10,4" VerticalAlignment="Center">
                                                    <TextBlock x:Name="DashboardInTransitCount" Text="0" Foreground="White" FontSize="11" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <DataGrid Grid.Row="1"
                                                  x:Name="DashboardInTransitGrid"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  IsReadOnly="True"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderThickness="0"
                                                  Background="White"
                                                  RowBackground="White"
                                                  AlternatingRowBackground="#F8FBFF"
                                                  AlternationCount="2"
                                                  SelectionMode="Single"
                                                  Margin="14,10,14,14"
                                                  MouseDoubleClick="DashboardTrackingGrid_MouseDoubleClick">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Challan" Binding="{Binding ChallanNo}" Width="110" />
                                                <DataGridTextColumn Header="Dispatch Dt." Binding="{Binding DispatchDate, StringFormat=dd-MMM-yy}" Width="100" />
                                                <DataGridTextColumn Header="From" Binding="{Binding From}" Width="*" />
                                                <DataGridTextColumn Header="To" Binding="{Binding To}" Width="*" />
                                                <DataGridTextColumn Header="Vehicle" Binding="{Binding VehicleNo}" Width="120" />
                                                <DataGridTemplateColumn Header="Eway Till" Width="96">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding EwayBillTillDate, StringFormat=dd-MMM-yy}"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="#111827" />
                                                                        <Setter Property="FontWeight" Value="Normal" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsEwayDueSoon}" Value="True">
                                                                                <Setter Property="Foreground" Value="#DC2626" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Latest Update" Binding="{Binding LatestReport}" Width="2*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- Bill Ledger View -->
                    <Grid x:Name="BillLedgerView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,8">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock Text="Total Records" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding TotalCount}" FontSize="13" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Margin="0,0,40,0">
                                        <TextBlock Text="Total Due" FontSize="11" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" />
                                        <TextBlock Text="{Binding FilteredTotalDue, StringFormat=Rs. {0:N2}}" FontSize="13" Foreground="#DC2626" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="1" Content="+ Generate Bill" Style="{StaticResource GreenButtonStyle}" Click="OpenBillForm_Click" />
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" Background="#FAFAFA" BorderBrush="{StaticResource BorderLight}" BorderThickness="0,0,0,1" Padding="16,8">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Search &amp; Filter" FontSize="12" Foreground="{StaticResource TextDark}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBox x:Name="BillSearchBox" TextChanged="BillSearchBox_TextChanged" Width="200" Height="26" BorderBrush="{StaticResource BorderLight}" FontSize="12" Padding="4,2" Margin="0,0,16,0" />
                                <Button Content="↻" Background="{StaticResource ThemeGreen}" Foreground="White" BorderThickness="0" Width="26" Height="26" Margin="4,0" Cursor="Hand" Click="BillRefresh_Click" ToolTip="Clear Filters" />
                                <Button x:Name="BillDeleteButton" Content="🗑" Background="#E53935" Foreground="White" BorderThickness="0" Width="26" Height="26" Margin="4,0" Cursor="Hand" Click="BillDeleteSelected_Click" ToolTip="Delete Selected" />
                                <Button x:Name="BillImportButton" Content="📂" Background="#1565C0" Foreground="White" BorderThickness="0" Width="26" Height="26" Margin="4,0" Cursor="Hand" Click="ImportBill_Click" ToolTip="Import Bills from CSV" />
                                <Button x:Name="BillImportGuideButton" Content="?" Background="#374151" Foreground="White" BorderThickness="0" Width="26" Height="26" Margin="4,0" Cursor="Hand" Click="OpenImportGuide_Click" ToolTip="Import column names" />
                                <Button Content="Rs." Background="#00897B" Foreground="White" BorderThickness="0" Width="34" Height="26" Margin="4,0" Cursor="Hand" Click="OpenReceiveBillAmount_Click" ToolTip="Receive Bill Amount" />
                                <Button Content="🧾" Background="#6D4C41" Foreground="White" BorderThickness="0" Width="26" Height="26" Margin="4,0" Cursor="Hand" Click="OpenBillReceiptHistory_Click" ToolTip="Bill Receipt History" />
                                <Button Content="Σ" Background="#6D4C41" Foreground="White" BorderThickness="0" Width="26" Height="26" Margin="4,0" Cursor="Hand" Click="OpenPartyBillSummary_Click" ToolTip="Party-wise Bill Due Summary" />
                                <Button Content="⚙P" Background="#7C3AED" Foreground="White" BorderThickness="0" Width="30" Height="26" Margin="4,0" Cursor="Hand" Click="OpenBillPrefixSettings_Click" ToolTip="Bill Prefix Settings" />
                                <Button Content="⚙" Background="{StaticResource ThemeBlue}" Foreground="White" BorderThickness="0" Width="26" Height="26" Margin="4,0" Cursor="Hand" Click="ShowBillColumnsMenu_Click" ToolTip="Show/Hide Columns" />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2" Margin="16,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="BillRecordCountText" Text="Loading..." FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BillFirstPageButton" Content="First" Width="52" Height="24" Margin="0,0,6,0" Padding="8,0" Click="BillFirstPage_Click" />
                                <Button x:Name="BillPrevPageButton" Content="Previous" Width="72" Height="24" Margin="0,0,6,0" Padding="8,0" Click="BillPrevPage_Click" />
                                <TextBlock x:Name="BillPageInfoText" Text="{Binding PageInfo}" FontSize="12" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <Button x:Name="BillNextPageButton" Content="Next" Width="60" Height="24" Margin="0,0,6,0" Padding="8,0" Click="BillNextPage_Click" />
                                <Button x:Name="BillLastPageButton" Content="Last" Width="52" Height="24" Padding="8,0" Click="BillLastPage_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="3">
                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <DataGrid ItemsSource="{Binding PagedEntries}" AutoGenerateColumns="False" CanUserAddRows="False" x:Name="BillLedgerGrid"
                                      ScrollViewer.HorizontalScrollBarVisibility="Visible" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      VirtualizingPanel.VirtualizationMode="Recycling"
                                      Background="White" BorderThickness="0" RowHeight="30" RowHeaderWidth="28" HeadersVisibility="All"
                                      FontSize="12" SelectionUnit="CellOrRowHeader"
                                      BeginningEdit="BillLedgerGrid_BeginningEdit"
                                      CellEditEnding="BillLedgerGrid_CellEditEnding"
                                      PreviewKeyDown="DataGrid_PreviewKeyDown"
                                      PreviewMouseLeftButtonDown="BillLedgerGrid_PreviewMouseLeftButtonDown"
                                      PreviewMouseMove="BillLedgerGrid_PreviewMouseMove"
                                      PreviewMouseLeftButtonUp="BillLedgerGrid_PreviewMouseLeftButtonUp"
                                      PreviewMouseRightButtonUp="BillLedgerGrid_PreviewMouseRightButtonUp"
                                      Sorting="BillLedgerGrid_SortingMenuOnly"
                                      Loaded="BillLedgerGrid_Loaded"
                                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}">
                                <DataGrid.RowStyle>
                                    <Style TargetType="DataGridRow">
                                        <Setter Property="Background" Value="{Binding GroupColor}" />
                                        <Setter Property="Foreground" Value="#111827" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#E3F2FD" />
                                                <Setter Property="Foreground" Value="#0F172A" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.RowStyle>
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell">
                                        <Setter Property="BorderBrush" Value="#E5E7EB" />
                                        <Setter Property="BorderThickness" Value="0,0,1,1" />
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="#DBEAFE" />
                                                <Setter Property="BorderBrush" Value="#93C5FD" />
                                                <Setter Property="Foreground" Value="#0F172A" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <Border Background="#F5F5F5" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="6,4">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Bill: " FontWeight="SemiBold" FontSize="12" Foreground="#333" />
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#18609A" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </DataGrid.GroupStyle>
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="BILL NO." Width="100" SortMemberPath="BillNo">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding BillNoDisplay}" FontWeight="SemiBold" VerticalAlignment="Center" Padding="4,0" ToolTip="{Binding CommentPreview}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Background" Value="Transparent" />
                                                            <Setter Property="Foreground" Value="#0F172A" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasComments}" Value="True">
                                                                    <Setter Property="Background" Value="#FDE68A" />
                                                                    <Setter Property="Foreground" Value="#92400E" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                    <TextBlock.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="View / Add Comment" Click="AddBillComment_Click" Tag="{Binding}" />
                                                        </ContextMenu>
                                                    </TextBlock.ContextMenu>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="BILL DATE" Binding="{Binding BillDate, StringFormat=dd-MMM-yyyy}" Width="90" />
                                    <DataGridTextColumn Header="PARTY" Binding="{Binding Party}" Width="120" />
                                    <DataGridTextColumn Header="LR NO." Binding="{Binding LRNo}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="LR DATE" Binding="{Binding LRDate, StringFormat=dd-MMM-yyyy}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="FROM" Binding="{Binding From}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="TO" Binding="{Binding To}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Vehicle Type" Binding="{Binding VehicleType}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="FREIGHT" Binding="{Binding Freight, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="DETENTION" Binding="{Binding Detention, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="HML" Binding="{Binding HML, StringFormat=N2}" Width="60" IsReadOnly="True" />
                                    <DataGridTextColumn Header="OTHR" Binding="{Binding OTHR, StringFormat=N2}" Width="60" IsReadOnly="True" />
                                    <DataGridTextColumn Header="St. Charge" Binding="{Binding StCharge, StringFormat=N2}" Width="80" IsReadOnly="True" />
                                    <DataGridTextColumn Header="TOTAL" Binding="{Binding Total, StringFormat=N2}" Width="80" IsReadOnly="True" Foreground="#18609A" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="RCVD" Binding="{Binding RCVD, StringFormat=N2}" Width="70" IsReadOnly="True" />
                                    <DataGridTextColumn Header="TDS" Binding="{Binding TDS, StringFormat=N2}" Width="60" IsReadOnly="True" />
                                    <DataGridTextColumn Header="DED" Binding="{Binding DED, StringFormat=N2}" Width="60" IsReadOnly="True" />
                                    <DataGridTextColumn Header="DUE" Binding="{Binding Due, StringFormat=N2}" Width="80" IsReadOnly="True" Foreground="#DC2626" FontWeight="Bold" />
                                    <DataGridTextColumn Header="MOP" Binding="{Binding MOP}" Width="60" IsReadOnly="True" />
                                    <DataGridTextColumn Header="MR" Binding="{Binding MR}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="RECEIVED DATE" Binding="{Binding Date, StringFormat=dd-MMM-yyyy}" Width="110" IsReadOnly="True" />
                                    <DataGridTextColumn Header="REMARKS" Binding="{Binding Remarks}" Width="180" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border Grid.Row="1" Background="White" BorderBrush="#EEEEEE" BorderThickness="0,1,0,0" Padding="10,8">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock x:Name="BillRecordsTextBlock" Text="{Binding FilteredEntriesCount, StringFormat='Records: {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextDark}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding FilteredTotalDue, StringFormat='Total Due: Rs. {0:N2}'}" FontSize="13" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Party Ledger View -->
                    <Grid x:Name="PartyLedgerView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="White">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Party Ledger" FontSize="20" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="+ Add Row" Height="26" Margin="0,0,8,0" Padding="10,0" Background="#00B08B" Foreground="White" BorderThickness="0" Cursor="Hand" Click="PartyAddRow_Click" />
                                <Button x:Name="PartyImportButton" Grid.Column="2" Content="📂 Import" Height="26" Margin="0,0,8,0" Padding="10,0" Background="#1565C0" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ImportParty_Click" />
                                <Button x:Name="PartyDeleteButton" Grid.Column="3" Content="🗑 Delete" Height="26" Margin="0,0,8,0" Padding="10,0" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" Click="PartyDeleteSelected_Click" />
                                <TextBox Grid.Column="4" x:Name="PartySearchBox" TextChanged="PartySearchBox_TextChanged" Width="200" Height="26" FontSize="12" Padding="4,2" BorderBrush="#CCC" />
                            </Grid>
                            <DataGrid x:Name="PartyGrid" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      Background="White" BorderThickness="1" BorderBrush="#DDD" RowHeight="30"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      GridLinesVisibility="All" HeadersVisibility="All"
                                      ColumnHeaderStyle="{StaticResource DataGridHeaderStyle}"
                                      SelectionMode="Extended"
                                      CellEditEnding="PartyGrid_CellEditEnding">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sr." Binding="{Binding Sr}" Width="40" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Party Name" Binding="{Binding PartyName}" Width="200" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="300" />
                                    <DataGridTextColumn Header="GST No." Binding="{Binding GSTNo}" Width="150" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>

                    <!-- Vehicle Ledger View -->
                    <Grid x:Name="VehicleLedgerView" Grid.Row="1" Grid.RowSpan="4" Visibility="Collapsed" Background="White">
                        <Grid Margin="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0" Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Vehicle Ledger" FontSize="20" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="📥 Import" Height="26" Margin="0,0,8,0" Padding="10,0" Background="#00B08B" Foreground="White" BorderThickness="0" Cursor="Hand" Click="ImportVehicle_Click" HorizontalAlignment="Right" />
                                <Button x:Name="VehicleDeleteButton" Grid.Column="2" Content="🗑 Delete" Height="26" Margin="0,0,8,0" Padding="10,0" Background="#DC2626" Foreground="White" BorderThickness="0" Cursor="Hand" Click="VehicleDeleteSelected_Click" HorizontalAlignment="Right" />
                                <TextBox Grid.Column="3" x:Name="VehicleSearchBox" TextChanged="VehicleSearchBox_TextChanged" Width="220" Height="26" FontSize="12" Padding="4,2" BorderBrush="#CCC" HorizontalAlignment="Right" />
                            </Grid>
